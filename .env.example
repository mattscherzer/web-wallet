# `npm run dev` uses .env.development (the local Supabase stack) and needs no setup.
# Production is only reachable through `npm run dev:prod`, which reads
# .env.prod.local (gitignored). Copy this block there and fill in the real values.
# Never put production keys in a tracked file or in .env.
#
# .env.prod.local
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
